rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Allow anyone to read existing users for the purpose of finding an email via username during login.
    // We restrict write access to authenticated users.
    match /users/{userId} {
      allow read: if true; 
      allow write: if request.auth != null;
    }

    match /meetings/{meetingId} {
      allow read, write: if request.auth != null;
    }

    match /announcements/{announcementId} {
      allow read, write: if request.auth != null;
    }

    match /plans/{planId} {
      allow read, write: if request.auth != null;
    }

    match /reports/{reportId} {
      allow read, write: if request.auth != null;
    }

    match /finance_transactions/{docId} {
      allow read, write: if request.auth != null;
    }

    match /finance_budgets/{docId} {
      allow read, write: if request.auth != null;
    }

    match /finance_reports/{docId} {
      allow read, write: if request.auth != null;
    }

    match /notifications/{docId} {
      allow read, write: if request.auth != null;
    }

    match /hierarchy/{docId} {
      allow read, write: if request.auth != null;
    }

    match /teachings/{docId} {
      allow read, write: if request.auth != null;
    }

    match /missionary_applications/{docId} {
      allow read, write: if request.auth != null;
    }

    match /missionary_reports/{docId} {
      allow read, write: if request.auth != null;
    }

    match /documents/{docId} {
      allow read, write: if request.auth != null;
    }

    match /members/{docId} {
      allow read, write: if request.auth != null;
    }

    match /strategic_plans/{docId} {
      allow read, write: if request.auth != null;
    }
  }
}
