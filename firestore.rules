rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    match /users/{userId} {
      allow read: if request.auth != null; 
      allow write: if request.auth != null;
    }

    match /meetings/{meetingId} {
      allow read, write: if request.auth != null;
    }

    match /announcements/{announcementId} {
      allow read, write: if request.auth != null;
    }

    match /plans/{planId} {
      allow read, write: if request.auth != null;
    }

    match /reports/{reportId} {
      allow read, write: if request.auth != null;
    }

    match /finance_transactions/{docId} {
      allow read, write: if request.auth != null;
    }

    match /finance_budgets/{docId} {
      allow read, write: if request.auth != null;
    }

    match /finance_reports/{docId} {
      allow read, write: if request.auth != null;
    }

    match /notifications/{docId} {
      allow read, write: if request.auth != null;
    }

    match /hierarchy/{docId} {
      allow read, write: if request.auth != null;
    }

    match /teachings/{docId} {
      allow read, write: if request.auth != null;
    }

    match /missionary_applications/{docId} {
      allow read, write: if request.auth != null;
    }

    match /missionary_reports/{docId} {
      allow read, write: if request.auth != null;
    }

    match /documents/{docId} {
      allow read, write: if request.auth != null;
    }

    match /members/{docId} {
      allow read, write: if request.auth != null;
    }

    match /strategic_plans/{docId} {
      allow read, write: if request.auth != null;
    }

    // Landing page config & page strings — public read, admin-only write.
    // hierarchyLevel lives on the user's Firestore document (no custom claims are set).
    match /siteConfig/{docId} {
      allow read: if true;
      allow write: if request.auth != null
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.hierarchyLevel in ['Sinodos', 'KuamiSinodos', 'Memriya'];
    }
  }
}
